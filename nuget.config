<?xml version="1.0" encoding="utf-8"?>
<!--
  Nabra has ZERO NuGet package dependencies, so restore never needs the internet.
  Clearing the sources avoids the "NuGet restore" errors seen with the earlier prototype.
  If you ever add a package, delete this file (or add nuget.org back as a source).
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
