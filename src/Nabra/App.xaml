<Application x:Class="Nabra.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="App_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped at runtime between Light.xaml and Dark.xaml. Keep it first. -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Defaults; ThemeService overrides these with the user's accent colour. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0E9F8E"/>
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A0E9F8E"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
