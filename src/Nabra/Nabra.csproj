<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the system-tray icon (NotifyIcon). It is built into .NET, no NuGet needed. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Disabled on purpose: WPF + WinForms implicit usings create ambiguous type names. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nabra</AssemblyName>
    <RootNamespace>Nabra</RootNamespace>
    <ApplicationIcon>Assets\nabra.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyTitle>Nabra</AssemblyTitle>
    <Product>Nabra</Product>
    <Description>Fix text typed with the wrong keyboard layout (Arabic / English). 100% local.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nabra.Core\Nabra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\nabra.ico" />
    <Resource Include="Assets\*.png" />
    <Content Include="Uninstall.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\nabra.ico">
      <Link>app.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
