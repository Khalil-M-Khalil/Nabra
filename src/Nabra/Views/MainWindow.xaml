<Window x:Class="Nabra.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nabra.Localization"
        Title="Nabra — نبْرة"
        Width="1060" Height="740" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma"
        FontSize="14"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <!-- The Margin provides space for the drop shadow and the 3D tilt animation -->
        <Border x:Name="ScaleHost" Margin="25" CornerRadius="20" Background="{DynamicResource WindowBgGradient}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.4" Direction="270" Color="Black"/>
            </Border.Effect>
            <Border.LayoutTransform>
                <ScaleTransform x:Name="UiScaleTransform"/>
            </Border.LayoutTransform>
            <Border.RenderTransform>
                <!-- Center origin for tilt animation -->
                <TransformGroup>
                    <SkewTransform/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Sidebar (Floating Glass) ============ -->
                <Border Grid.Column="0" CornerRadius="16" Margin="16,16,8,16"
                        Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1">
                    <DockPanel Margin="16,22,16,18" LastChildFill="True">

                        <!-- Quick on/off, always visible -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0" Padding="14,12" Background="{DynamicResource SurfaceAltBg}" BorderBrush="{DynamicResource BorderBrushSoft}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{loc:Tr side_quick_toggle}"/>
                                </StackPanel>
                                <CheckBox x:Name="StatusToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          Checked="StatusToggle_Changed" Unchecked="StatusToggle_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Brand -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                            <Image Source="{DynamicResource BrandLogo}" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="نبْرة" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Nabra" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Navigation -->
                        <StackPanel>
                            <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource NavItem}"
                                         Tag="&#xE80F;" Content="{loc:Tr nav_home}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavShortcuts" GroupName="nav" Style="{StaticResource NavItem}"
                                         Tag="&#xE765;" Content="{loc:Tr nav_shortcuts}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavItem}"
                                         Tag="&#xE713;" Content="{loc:Tr nav_settings}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout" GroupName="nav" Style="{StaticResource NavItem}"
                                         Tag="&#xE946;" Content="{loc:Tr nav_about}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ Page host ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Custom Window Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,20,0">
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Width="30" Height="30" Click="MinBtn_Click"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Width="30" Height="30" Click="CloseBtn_Click"/>
                    </StackPanel>

                    <ContentControl x:Name="PageHost" Grid.Row="1" IsTabStop="False" Margin="10,0,10,10"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
