<UserControl x:Class="Nabra.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nabra.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,30,34,30" MaxWidth="860">

            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr nav_settings}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,22" Text="{loc:Tr set_subtitle}"/>

            <!-- General -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,8" Text="{loc:Tr set_general}"/>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr set_startup}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr set_startup_desc}"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr set_tray}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr set_tray_desc}"/>
                        </StackPanel>
                        <CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr set_notify}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr set_notify_desc}"/>
                        </StackPanel>
                        <CheckBox x:Name="NotifyToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr set_sound}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr set_sound_desc}"/>
                        </StackPanel>
                        <CheckBox x:Name="SoundToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Conversion -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,8" Text="{loc:Tr set_conversion}"/>

                    <StackPanel Margin="0,10">
                        <TextBlock FontWeight="SemiBold" Text="{loc:Tr home_mode_title}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" Text="{loc:Tr set_mode_desc}"/>
                        <Border Style="{StaticResource SegContainer}" IsEnabled="False" Opacity="0.6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeAuto" GroupName="setmode" Style="{StaticResource SegItem}" Tag="Auto" Content="{loc:Tr mode_auto}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="ModeToArabic" GroupName="setmode" Style="{StaticResource SegItem}" Tag="ToArabic" Content="{loc:Tr mode_to_ar}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="ModeToEnglish" GroupName="setmode" Style="{StaticResource SegItem}" Tag="ToEnglish" Content="{loc:Tr mode_to_en}" Checked="Seg_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr set_restore}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr set_restore_desc}"/>
                        </StackPanel>
                        <CheckBox x:Name="RestoreToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontWeight="SemiBold" Text="{loc:Tr set_speed}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" Text="{loc:Tr set_speed_desc}"/>
                        <Border Style="{StaticResource SegContainer}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SpeedFast" GroupName="speed" Style="{StaticResource SegItem}" Tag="Fast" Content="{loc:Tr speed_fast}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="SpeedNormal" GroupName="speed" Style="{StaticResource SegItem}" Tag="Normal" Content="{loc:Tr speed_normal}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="SpeedRelaxed" GroupName="speed" Style="{StaticResource SegItem}" Tag="Relaxed" Content="{loc:Tr speed_relaxed}" Checked="Seg_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Real-Time Correction -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Tr rt_section_title}"/>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="قريباً / Soon" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" Text="{loc:Tr rt_subtitle}"/>

                    <StackPanel IsEnabled="False" Opacity="0.5">
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr rt_enable}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr rt_enable_desc}"/>
                            </StackPanel>
                            <CheckBox x:Name="RealTimeToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <StackPanel Margin="0,10">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr rt_timeout_title}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" Text="{loc:Tr rt_timeout_desc}"/>
                            <Border Style="{StaticResource SegContainer}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Timeout10" GroupName="rttimeout" Style="{StaticResource SegItem}" Tag="1.0" Content="1.0 ثانية" Checked="Seg_Checked"/>
                                    <RadioButton x:Name="Timeout15" GroupName="rttimeout" Style="{StaticResource SegItem}" Tag="1.5" Content="1.5 ثانية" Checked="Seg_Checked"/>
                                    <RadioButton x:Name="Timeout20" GroupName="rttimeout" Style="{StaticResource SegItem}" Tag="2.0" Content="2.0 ثانية" Checked="Seg_Checked"/>
                                    <RadioButton x:Name="Timeout30" GroupName="rttimeout" Style="{StaticResource SegItem}" Tag="3.0" Content="3.0 ثوانٍ" Checked="Seg_Checked"/>
                                    <RadioButton x:Name="Timeout50" GroupName="rttimeout" Style="{StaticResource SegItem}" Tag="5.0" Content="5.0 ثوانٍ" Checked="Seg_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr rt_smart_title}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr rt_smart_desc}"/>
                            </StackPanel>
                            <CheckBox x:Name="RealTimeSmartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock FontWeight="SemiBold" Text="{loc:Tr rt_enter_title}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr rt_enter_desc}"/>
                            </StackPanel>
                            <CheckBox x:Name="RealTimeEnterToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr rt_tester_title}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{loc:Tr rt_tester_desc}"/>
                            <TextBox x:Name="RealTimeTestBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="120"
                                     Padding="12,10" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Elevation / System Privileges -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,4" Text="{loc:Tr elevate_card_title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" Text="{loc:Tr elevate_card_desc}"/>

                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ElevateStatusText" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                        <Button x:Name="ElevateBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Padding="16,8" Click="ElevateBtn_Click" Content="{loc:Tr elevate_btn}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Margin="0,0,0,8" Text="{loc:Tr set_appearance}"/>

                    <StackPanel Margin="0,10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,10" Text="{loc:Tr set_theme}"/>
                        <Border Style="{StaticResource SegContainer}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource SegItem}" Tag="System" Content="{loc:Tr theme_system}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource SegItem}" Tag="Light" Content="{loc:Tr theme_light}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource SegItem}" Tag="Dark" Content="{loc:Tr theme_dark}" Checked="Seg_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>

                    <StackPanel Margin="0,10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,10" Text="{loc:Tr set_language}"/>
                        <Border Style="{StaticResource SegContainer}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangAr" GroupName="lang" Style="{StaticResource SegItem}" Tag="ar" Content="العربية" Checked="Seg_Checked"/>
                                <RadioButton x:Name="LangEn" GroupName="lang" Style="{StaticResource SegItem}" Tag="en" Content="English" Checked="Seg_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>

                    <StackPanel Margin="0,10">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,10" Text="{loc:Tr set_size}"/>
                        <Border Style="{StaticResource SegContainer}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Scale090" GroupName="scale" Style="{StaticResource SegItem}" Tag="0.9" Content="{loc:Tr size_small}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="Scale100" GroupName="scale" Style="{StaticResource SegItem}" Tag="1.0" Content="{loc:Tr size_normal}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="Scale115" GroupName="scale" Style="{StaticResource SegItem}" Tag="1.15" Content="{loc:Tr size_large}" Checked="Seg_Checked"/>
                                <RadioButton x:Name="Scale130" GroupName="scale" Style="{StaticResource SegItem}" Tag="1.3" Content="{loc:Tr size_xlarge}" Checked="Seg_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,10" Text="{loc:Tr set_accent}"/>
                        <WrapPanel x:Name="AccentPanel" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" Text="{loc:Tr set_accent_custom}"/>
                            <TextBox x:Name="AccentHex" Width="130" Padding="10,7" FontSize="14" FlowDirection="LeftToRight"
                                     MaxLength="7" LostFocus="AccentHex_LostFocus" KeyDown="AccentHex_KeyDown"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr set_data}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" Text="{loc:Tr set_data_desc}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Content="{loc:Tr btn_open_folder}" Click="OpenFolder_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="{loc:Tr btn_reset_all}" Click="Reset_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
