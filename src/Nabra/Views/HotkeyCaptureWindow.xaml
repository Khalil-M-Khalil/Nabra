<Window x:Class="Nabra.Views.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nabra.Localization"
        Title="{loc:Tr cap_window_title}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma"
        FontSize="14"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <StackPanel Margin="28,26,28,24">
        <TextBlock Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap" Text="{loc:Tr cap_prompt}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,18" Text="{loc:Tr cap_hint}"/>

        <Border Style="{StaticResource Card}" Margin="0" MinHeight="88" Padding="18">
            <Grid>
                <WrapPanel x:Name="Chips" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="Placeholder" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{loc:Tr cap_waiting}"/>
            </Grid>
        </Border>

        <Border x:Name="Banner" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="96"
                    Content="{loc:Tr btn_save}" Click="Save_Click" IsEnabled="False"/>
            <Button MinWidth="96" Content="{loc:Tr btn_cancel}" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
