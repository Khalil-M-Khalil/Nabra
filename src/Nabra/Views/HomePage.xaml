<UserControl x:Class="Nabra.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nabra.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,30,34,30" MaxWidth="860">

            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr home_title}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,22" Text="{loc:Tr home_subtitle}"/>

            <!-- Status -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Style="{StaticResource H2}"/>
                            <Border x:Name="ElevateBadge" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" Background="{DynamicResource SurfaceAltBg}">
                                <TextBlock x:Name="ElevateBadgeText" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusHint" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="LastText" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="EnableToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              Checked="Enable_Changed" Unchecked="Enable_Changed"/>
                </Grid>
            </Border>

            <!-- Real-Time Quick Toggle -->
            <Border Style="{StaticResource Card}" IsEnabled="False" Opacity="0.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr rt_section_title}"/>
                            <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0" Background="{DynamicResource DangerSoftBrush}">
                                <TextBlock Text="قريباً / Soon" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{loc:Tr rt_enable_desc}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="False"/>
                </Grid>
            </Border>

            <!-- Current shortcut -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr home_hotkey_title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" Text="{loc:Tr home_hotkey_desc}"/>
                    <WrapPanel x:Name="HotkeyChips" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Content="{loc:Tr btn_change_hotkey}" Click="ChangeHotkey_Click"/>
                    <Border x:Name="Banner" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr home_mode_title}"/>
                    <TextBlock x:Name="ModeDesc" Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                    <Border Style="{StaticResource SegContainer}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeAuto" GroupName="homemode" Style="{StaticResource SegItem}"
                                         Tag="Auto" Content="{loc:Tr mode_auto}" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeToArabic" GroupName="homemode" Style="{StaticResource SegItem}"
                                         Tag="ToArabic" Content="{loc:Tr mode_to_ar}" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeToEnglish" GroupName="homemode" Style="{StaticResource SegItem}"
                                         Tag="ToEnglish" Content="{loc:Tr mode_to_en}" Checked="Mode_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Local tester -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr tester_title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" Text="{loc:Tr tester_desc}"/>
                    <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="190"
                             TextChanged="Input_TextChanged"/>
                    <TextBlock x:Name="DirectionLabel" Style="{StaticResource Muted}" Margin="2,12,2,8"/>
                    <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="190"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Content="{loc:Tr btn_copy}" Click="Copy_Click"/>
                        <Button Margin="0,0,8,0" Content="{loc:Tr btn_example}" Click="Example_Click"/>
                        <Button Content="{loc:Tr btn_clear}" Click="Clear_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
